# qa-toolkit-mcp — example configuration
#
# Copy this file to `.env` (no suffix) in the project root and edit the values.
# `.env` is gitignored — each machine / user has its own.
#
# Precedence (highest priority first):
#   1. Real OS environment variables (claude_desktop_config.json, your shell, etc.)
#   2. .env in this directory (project root)
#   3. .env in the current working directory where the server starts
#   4. Hardcoded defaults
#
# To override a single value temporarily, just set it in your shell:
#   PowerShell:   $env:QA_TOOLKIT_RUNS_DIR = "C:\path\to\reports"
#   bash:         export QA_TOOLKIT_RUNS_DIR=/path/to/reports

# ──────────────────────────────────────────────────────────────────────────────
# QA_TOOLKIT_RUNS_DIR
#
# Absolute path to the directory containing your test run reports. Both
# formats are auto-detected:
#   - native run-report.v1.json (with `schema_version`)
#   - classification reports (`*_classification.json`) + optional JUnit XML sibling
#
# If unset, defaults to `./runs/` relative to the server's working directory.
# ──────────────────────────────────────────────────────────────────────────────
QA_TOOLKIT_RUNS_DIR=C:\Dev\building\mcp\qa-toolkit-mcp\runs

# ──────────────────────────────────────────────────────────────────────────────
# QA_TOOLKIT_LOG_LEVEL
#
# Python logging level for the server. One of:
#   DEBUG | INFO | WARNING | ERROR | CRITICAL
# Logs always go to stderr (stdio servers must not write to stdout).
# Defaults to INFO.
# ──────────────────────────────────────────────────────────────────────────────
QA_TOOLKIT_LOG_LEVEL=INFO
